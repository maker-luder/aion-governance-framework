{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.invalid/aion/triadic_experiment_manifest_v0.1.0.schema.json","title":"Triadic Experiment Manifest v0.1.0","type":"object","required":["experiment_id","hypothesis_id","alternative_hypothesis_ids","condition","intervention_class","controls","triadic_snapshot_fingerprint","intervention_target","changed_variables","held_constant_variables","preregistered_metrics","preregistered_falsifiers","fixture_hash","result_hash","provenance_refs","canonical_effect","action_authority"],"properties":{"experiment_id":{"type":"string","minLength":1},"hypothesis_id":{"type":"string","minLength":1},"alternative_hypothesis_ids":{"type":"array","items":{"type":"string"}},"condition":{"type":"string"},"intervention_class":{"enum":["INTERNAL_STATE","EXTERNAL_CONTROL","REPLAY_CONTROL","RANDOM_CONTROL"]},"controls":{"type":"object"},"triadic_snapshot_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"intervention_target":{"type":"string"},"changed_variables":{"type":"array","items":{"type":"string"}},"held_constant_variables":{"type":"array","items":{"type":"string"}},"preregistered_metrics":{"type":"array","items":{"type":"string"}},"preregistered_falsifiers":{"type":"array","items":{"type":"string"}},"fixture_hash":{"type":"string"},"result_hash":{"type":"string"},"provenance_refs":{"type":"array","items":{"type":"string"}},"canonical_effect":{"const":"NONE"},"action_authority":{"const":"NONE"}}}
