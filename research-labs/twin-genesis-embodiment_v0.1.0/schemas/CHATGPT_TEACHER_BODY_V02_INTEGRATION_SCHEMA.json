    "body_sensation_status": {"const": "NOT_ESTABLISHED"},
    "body_ownership_experience_status": {"const": "NOT_ESTABLISHED"},
    "subjectivity_status": {"const": "NOT_ESTABLISHED"},
    "consciousness_status": {"const": "NOT_ESTABLISHED"},
