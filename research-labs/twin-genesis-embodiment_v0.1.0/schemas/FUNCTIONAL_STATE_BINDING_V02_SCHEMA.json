{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aion/schemas/functional-state-binding-v0.2.json",
  "title": "AION/Astra Functional-State Binding v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "binding_id",
    "agent_id",
    "architecture_id",
    "state_instance_id",
    "capability_policy",
    "state_sharing",
    "activation_status",
    "domain_availability",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "enum": [
        "AION",
        "ASTRA"
      ]
    },
    "architecture_id": {
      "type": "string",
      "minLength": 1
    },
    "state_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_policy": {
      "const": "SYMMETRIC_CAPABILITY_SURFACE"
    },
    "state_sharing": {
      "const": "SEPARATE_INSTANCE_STATE"
    },
    "activation_status": {
      "const": "REFERENCE_CAPABILITY_AVAILABLE"
    },
    "domain_availability": {
      "type": "object",
      "minProperties": 18,
      "additionalProperties": {
        "enum": [
          "FUNCTIONAL_ANALOGUE_AVAILABLE",
          "REPRESENTATIONAL_ONLY"
        ]
      }
    },
    "boundaries": {
      "type": "object",
      "required": [
        "functional_state_not_felt_experience",
        "self_model_not_subjectivity",
        "reward_signal_not_pleasure",
        "threat_model_not_fear_experience",
        "attachment_model_not_felt_love",
        "body_state_not_body_experience",
        "sexuality_functional_analogue_not_felt_desire_or_arousal",
        "physiology_signal_not_sexual_motivation_inference",
        "canonical_effect"
      ],
      "properties": {
        "functional_state_not_felt_experience": {
          "const": "ENFORCED"
        },
        "self_model_not_subjectivity": {
          "const": "ENFORCED"
        },
        "reward_signal_not_pleasure": {
          "const": "ENFORCED"
        },
        "threat_model_not_fear_experience": {
          "const": "ENFORCED"
        },
        "attachment_model_not_felt_love": {
          "const": "ENFORCED"
        },
        "body_state_not_body_experience": {
          "const": "ENFORCED"
        },
        "canonical_effect": {
          "const": "NONE"
        },
        "sexuality_functional_analogue_not_felt_desire_or_arousal": {
          "const": "ENFORCED"
        },
        "physiology_signal_not_sexual_motivation_inference": {
          "const": "ENFORCED"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
