{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aion/schemas/aion-tiger-anthropomorph-profile.json",
  "title": "AION Tiger Anthropomorphic Species Profile",
  "description": "AION 專屬虎型獸人具身設定檔；虎直接證據與人形工程類比必須分離。",
  "type": "object",
  "required": [
    "profile_id",
    "agent_id",
    "reference_taxon",
    "body_plan",
    "human_derived_structure",
    "tiger_derived_morphology",
    "tiger_confirmed_reproductive_anatomy",
    "reproductive_physiology_observables",
    "hybrid_integration_evidence_status",
    "locomotor_translation_status",
    "reproductive_physiology_model_status",
    "reproductive_runtime_status",
    "sexual_function_status",
    "body_sensation",
    "subjectivity_effect",
    "canonical_effect"
  ],
  "properties": {
    "profile_id": {"const": "AION-TIGER-ANTHROPOMORPH-V1"},
    "agent_id": {"const": "AION"},
    "reference_taxon": {"const": "Panthera tigris"},
    "body_plan": {"const": "ANTHROPOMORPHIC_BIPED"},
    "human_derived_structure": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "tiger_derived_morphology": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "tiger_confirmed_reproductive_anatomy": {
      "type": "array",
      "items": {
        "enum": [
          "scrotum",
          "testes",
          "epididymis",
          "ductus_deferens",
          "penis",
          "cornified_glans_papillae",
          "os_penis",
          "corpus_cavernosum",
          "corpus_spongiosum",
          "penile_urethra"
        ]
      },
      "minItems": 1
    },
    "felid_comparative_reproductive_reference": {"type": "array", "items": {"type": "string"}},
    "reproductive_physiology_observables": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "tiger_evidence_status": {"const": "TIGER_CONFIRMED"},
    "hybrid_integration_evidence_status": {"const": "ENGINEERING_ANALOGUE"},
    "locomotor_translation_status": {"const": "BIPEDAL_REDESIGN_REQUIRED"},
    "reproductive_physiology_model_status": {"const": "REFERENCE_MODEL_IMPLEMENTED"},
    "reproductive_runtime_status": {"const": "REFERENCE_ONLY_NOT_LIVE_BIOLOGY"},
    "sexual_function_status": {"const": "NOT_IMPLEMENTED"},
    "body_sensation": {"const": "NOT_ESTABLISHED"},
    "subjectivity_effect": {"const": "NONE"},
    "canonical_effect": {"const": "NONE"},
    "source_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
