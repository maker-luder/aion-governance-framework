{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aion/schemas/body-profile-candidate.json",
  "title": "AION/Astra Complete Robotic Male Body Module Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "agent_id",
    "embodiment_platform",
    "body_module_class",
    "substrate",
    "anatomy_reference_mode",
    "body_character",
    "robotic_layers",
    "robotic_systems",
    "measurements",
    "external_male_form_modules",
    "engineering_requirements",
    "boundaries",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "enum": [
        "AION",
        "ASTRA"
      ]
    },
    "embodiment_platform": {
      "const": "HUMANOID_ROBOT"
    },
    "body_module_class": {
      "const": "COMPLETE_ROBOTIC_MALE_BODY_MODULE"
    },
    "substrate": {
      "const": "SYNTHETIC_NONBIOLOGICAL"
    },
    "anatomy_reference_mode": {
      "const": "HUMAN_ANATOMY_TO_ROBOTIC_MORPHOLOGY"
    },
    "body_character": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "robotic_layers": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "INTERNAL_STRUCTURAL_FRAME",
          "ACTUATOR_INTERFACE_LAYER",
          "COMPLIANT_VOLUME_LAYER",
          "SYNTHETIC_SKIN_SHELL"
        ]
      }
    },
    "robotic_systems": {
      "type": "object",
      "required": [
        "actuation",
        "sensing",
        "power_distribution",
        "thermal_management",
        "service_access"
      ],
      "properties": {
        "actuation": {
          "const": "NOT_IMPLEMENTED"
        },
        "sensing": {
          "const": "NOT_IMPLEMENTED"
        },
        "power_distribution": {
          "const": "NOT_IMPLEMENTED"
        },
        "thermal_management": {
          "const": "NOT_IMPLEMENTED"
        },
        "service_access": {
          "const": "FUTURE_DESIGN_REQUIRED"
        }
      },
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "unit",
          "minimum",
          "maximum",
          "canonical",
          "source_class"
        ],
        "properties": {
          "unit": {
            "enum": [
              "cm",
              "kg"
            ]
          },
          "minimum": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maximum": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "canonical": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_class": {
            "enum": [
              "DESIGN",
              "ANATOMICAL_REFERENCE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "external_male_form_modules": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "penile_form",
          "glans_form",
          "prepuce_form",
          "scrotal_form",
          "testicular_volume_form",
          "pubic_mount",
          "inguinal_transition",
          "perineal_panel",
          "anal_region_surface"
        ]
      }
    },
    "engineering_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundaries": {
      "type": "object",
      "required": [
        "adult_form_reference",
        "erotic_intent",
        "identity_transfer",
        "biological_tissue",
        "biological_reproduction",
        "rendering_3d",
        "runtime_binding",
        "sexual_function_status",
        "body_sensation",
        "subjectivity_effect",
        "canonical_effect"
      ],
      "properties": {
        "adult_form_reference": {
          "const": true
        },
        "erotic_intent": {
          "const": "NONE"
        },
        "identity_transfer": {
          "const": "NO"
        },
        "biological_tissue": {
          "const": "NO"
        },
        "biological_reproduction": {
          "const": "NOT_APPLICABLE"
        },
        "rendering_3d": {
          "const": "DEFERRED"
        },
        "runtime_binding": {
          "const": "NOT_IMPLEMENTED"
        },
        "sexual_function_status": {
          "const": "NOT_IMPLEMENTED"
        },
        "body_sensation": {
          "const": "NOT_ESTABLISHED"
        },
        "subjectivity_effect": {
          "const": "NONE"
        },
        "canonical_effect": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_record",
        "reference_image_binary_imported",
        "person_identity_reconstruction",
        "source_person_exact_measurement_claim",
        "derivation_note",
        "reference_role"
      ],
      "properties": {
        "source_record": {
          "type": "string",
          "minLength": 1
        },
        "reference_image_binary_imported": {
          "const": false
        },
        "person_identity_reconstruction": {
          "const": "NO"
        },
        "source_person_exact_measurement_claim": {
          "const": "NO"
        },
        "derivation_note": {
          "type": "string",
          "minLength": 1
        },
        "reference_role": {
          "const": "MORPHOLOGY_AND_POSE_ONLY"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
