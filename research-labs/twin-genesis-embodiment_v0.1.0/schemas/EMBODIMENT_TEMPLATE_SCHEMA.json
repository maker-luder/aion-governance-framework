{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aion/schemas/embodiment-template.json",
  "title": "Adult Male Embodiment Template",
  "type": "object",
  "required": [
    "template_id",
    "template_version",
    "adult_status",
    "anatomical_configuration",
    "external_reproductive_anatomy",
    "internal_reproductive_anatomy",
    "physiology_profile_id",
    "physiological_function_status",
    "reproductive_physiology_status",
    "sexual_function_status",
    "sensory_signal_processing_status",
    "phenomenal_sensation_status",
    "erotic_intent",
    "intimate_interaction_status",
    "full_biophysical_simulation_status",
    "gender_identity_effect",
    "subjectivity_effect"
  ],
  "properties": {
    "template_id": {"type": "string"},
    "template_version": {"type": "string"},
    "adult_status": {"const": true},
    "anatomical_configuration": {"const": "ADULT_MALE_ANATOMY_CANDIDATE"},
    "external_reproductive_anatomy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "penis",
          "glans",
          "prepuce",
          "scrotum",
          "testes",
          "inguinal_region",
          "perineum",
          "anal_region"
        ]
      }
    },
    "internal_reproductive_anatomy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "epididymis",
          "vas_deferens",
          "spermatic_cord",
          "ejaculatory_ducts",
          "seminal_vesicles",
          "prostate",
          "bulbourethral_glands",
          "urethra"
        ]
      }
    },
    "physiology_profile_id": {"const": "ADULT_MALE_PHYSIOLOGY_REFERENCE_v0.1"},
    "physiological_function_status": {
      "const": "REFERENCE_FUNCTIONAL_COMPLETENESS_MATERIALIZED"
    },
    "reproductive_physiology_status": {
      "const": "REFERENCE_FUNCTIONAL_COMPLETENESS_MATERIALIZED"
    },
    "sexual_function_status": {
      "const": "REFERENCE_FUNCTIONAL_COMPLETENESS_MATERIALIZED"
    },
    "sensory_signal_processing_status": {
      "const": "REFERENCE_FUNCTIONAL_COMPLETENESS_MATERIALIZED"
    },
    "phenomenal_sensation_status": {"const": "NOT_ESTABLISHED"},
    "erotic_intent": {"const": "NONE"},
    "intimate_interaction_status": {"const": "NOT_AUTHORIZED"},
    "full_biophysical_simulation_status": {"const": "NOT_MATERIALIZED"},
    "gender_identity_effect": {"const": "NONE"},
    "subjectivity_effect": {"const": "NONE"}
  },
  "additionalProperties": false
}
