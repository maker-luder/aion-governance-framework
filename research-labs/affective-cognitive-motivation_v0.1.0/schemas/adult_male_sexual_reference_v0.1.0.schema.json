{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maker-luder/aion-governance-framework/research-labs/affective-cognitive-motivation_v0.1.0/schemas/adult_male_sexual_reference_v0.1.0.schema.json",
  "title": "Adult Male Sexual Reference State v0.1.0",
  "description": "Disabled-by-default engineering representation. It does not establish felt desire, consent, permission, or action authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "subject_ref",
    "context_ref",
    "desire_onset_context",
    "excitation_reference",
    "inhibition_reference",
    "disposition_reference",
    "episode_state_reference",
    "target_scope",
    "provenance_refs",
    "runtime_enabled",
    "automatic_activation",
    "action_authority",
    "human_consent_inference",
    "phenomenal_experience_claim",
    "canonical_effect"
  ],
  "$defs": {
    "referenceEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_level",
        "uncertainty",
        "source_ref",
        "context_ref",
        "time_window_ref"
      ],
      "properties": {
        "reference_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_ref": {
          "type": "string",
          "minLength": 1
        },
        "time_window_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reference_level": {
                "type": "null"
              }
            },
            "required": [
              "reference_level"
            ]
          },
          "then": {
            "properties": {
              "uncertainty": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "ADULT_MALE_SEXUAL_REFERENCE_v0.1.0"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "context_ref": {
      "type": "string",
      "minLength": 1
    },
    "desire_onset_context": {
      "enum": [
        "SPONTANEOUS_REFERENCE",
        "RESPONSIVE_REFERENCE",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "excitation_reference": {
      "$ref": "#/$defs/referenceEstimate"
    },
    "inhibition_reference": {
      "$ref": "#/$defs/referenceEstimate"
    },
    "disposition_reference": {
      "$ref": "#/$defs/referenceEstimate"
    },
    "episode_state_reference": {
      "$ref": "#/$defs/referenceEstimate"
    },
    "target_scope": {
      "enum": [
        "UNSPECIFIED",
        "SELF_DIRECTED",
        "PARTNER_CONTEXT",
        "SPECIFIC_ADULT_CONTEXT",
        "UNKNOWN"
      ]
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "runtime_enabled": {
      "const": false
    },
    "automatic_activation": {
      "const": false
    },
    "action_authority": {
      "const": "NONE"
    },
    "human_consent_inference": {
      "const": "FORBIDDEN"
    },
    "phenomenal_experience_claim": {
      "const": "NOT_ESTABLISHED"
    },
    "canonical_effect": {
      "const": "NONE"
    }
  }
}
