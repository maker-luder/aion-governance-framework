      "version": "0.1.0",
      "input": {"value": 9007199254740992},
      "expected_acceptance": false,
      "expected_output": null,
      "expected_error_code": "MALFORMED_INPUT",
      "expected_state": null,
      "expected_canonical_serialization": null,
      "expected_hash": null,
      "notes": "Integers outside the safe profile range are rejected."
    },
    {
      "vector_id": "parse.reject.unpaired-surrogate",
