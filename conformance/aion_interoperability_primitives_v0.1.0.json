      "expected_output": null,
      "expected_error_code": "MALFORMED_INPUT",
      "expected_state": null,
      "expected_canonical_serialization": null,
      "expected_hash": null,
      "notes": "NaN is not admitted by the profile."
    },
    {
      "vector_id": "parse.reject.unsafe-integer",
