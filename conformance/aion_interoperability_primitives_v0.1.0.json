{
  "schema_version": "0.1.0",
  "profile_id": "AION-JCS-COMPATIBLE-0.1.0",
  "vectors": [
    {
      "vector_id": "canon.object.nested-nfc",
      "contract": "SerializationProfile",
      "version": "0.1.0",
      "input": {
        "z": [2, 1],
        "text": "é",
        "a": {"b": 2, "a": 1}
      },
      "expected_acceptance": true,
      "expected_output": "{\"a\":{\"a\":1,\"b\":2},\"text\":\"é\",\"z\":[2,1]}",
      "expected_error_code": null,
      "expected_state": null,
      "expected_canonical_serialization": "{\"a\":{\"a\":1,\"b\":2},\"text\":\"é\",\"z\":[2,1]}",
      "expected_hash": "84c04e5622ab242d7077755b9825dc1af657a5706afb993c0af1d518357bdf96",
      "notes": "Nested objects sort recursively; array order is preserved; accepted NFC text is emitted as UTF-8."
    },
    {
      "vector_id": "parse.reject.duplicate-key",
      "contract": "SerializationProfile",
      "version": "0.1.0",
      "input": "{\"x\":1,\"x\":2}",
      "expected_acceptance": false,
      "expected_output": null,
      "expected_error_code": "MALFORMED_INPUT",
      "expected_state": null,
      "expected_canonical_serialization": null,
      "expected_hash": null,
      "notes": "Raw-text admission rejects duplicate object members."
    },
    {
      "vector_id": "parse.reject.non-finite",
      "contract": "SerializationProfile",
      "version": "0.1.0",
      "input": "{\"value\":NaN}",
