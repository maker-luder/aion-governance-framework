{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aion/iqc/iqc_report.schema.json",
  "title": "AION IQC Inspection Report",
  "description": "Inspection-only report. It does not authorize merge, deployment, canonical promotion, independent IV&V, or scientific conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inspection_id",
    "target_head",
    "generated_at",
    "evaluator_role",
    "verdict",
    "checks",
    "canonical_effect",
    "independent_ivv_status",
    "mutation_performed"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "inspection_id": {"type": "string", "minLength": 1},
    "target_head": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "evaluator_role": {"const": "REPOSITORY_IQC_INSPECTION_ONLY"},
    "verdict": {"enum": ["PASS", "HOLD", "FAIL"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "area", "status", "detail", "evidence_refs", "critical"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "area": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "HOLD", "FAIL"]},
          "detail": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "critical": {"type": "boolean"}
        }
      }
    },
    "canonical_effect": {"const": "NONE"},
    "independent_ivv_status": {"const": "NOT_ACHIEVED"},
    "mutation_performed": {"const": false}
  }
}
