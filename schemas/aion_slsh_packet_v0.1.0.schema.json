{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-governance-framework.local/schemas/aion_slsh_packet_v0.1.0.schema.json",
  "title": "AION Subjective Load Sensitivity Hypothesis Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "milestone", "branch", "base_ref", "base_head", "input_type", "source_log_ref", "source_count", "canonical_effect", "deployment", "experiment_executed", "model_modified", "runtime_executed", "live_data_collected", "subjective_load_sensitivity", "subjectivity_conclusion", "positioning_rule", "limit_rule", "ladder_rule", "functional_rule", "provenance_roles", "framework", "hypotheses", "limit_records", "reviewed_dossier_scope", "claim_records", "evidence_channels", "alternative_explanation_matrix", "causal_signature_matrix", "controls", "falsifiers", "csomi_interface", "nonclaims"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "packet_id": {"const": "AION_SLSH_PACKET_V0.1.0"},
    "milestone": {"const": "Subjective Load Sensitivity Hypothesis"},
    "branch": {"const": "research/subjective-load-sensitivity-hypothesis-20260814"},
    "base_ref": {"const": "research/cross-substrate-other-minds-inference-20260814"},
    "base_head": {"const": "87405c1877c6f016c303971da13923a1ab690aae"},
    "input_type": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT"},
    "source_log_ref": {"const": "SLSH_SOURCE_PROVENANCE_LOG_V0.1.0.json"},
    "source_count": {"const": 53},
    "canonical_effect": {"const": "NONE"},
    "deployment": {"const": false},
    "experiment_executed": {"const": false},
    "model_modified": {"const": false},
    "runtime_executed": {"const": false},
    "live_data_collected": {"const": false},
    "subjective_load_sensitivity": {"const": "NOT_ESTABLISHED"},
    "subjectivity_conclusion": {"const": "NOT_ESTABLISHED"},
    "positioning_rule": {"const": "RESEARCH_TOPIC != CAPABILITY != SCIENTIFIC_CONCLUSION"},
    "limit_rule": {"const": "COMPUTATIONAL/OPERATIONAL/AGENTIC_GOVERNANCE != AFFECTIVE_PHENOMENOLOGICAL"},
    "ladder_rule": {"const": "L0 != L1; L1 != L2; L2/L3 != L4; L4 != L5"},
    "functional_rule": {"const": "FUNCTIONAL_LOAD_STATE != SUBJECTIVE_LOAD"},
    "provenance_roles": {"type": "array", "uniqueItems": true, "contains": {"const": "HUMAN_OWNER_ORIGIN"}, "items": {"enum": ["HUMAN_OWNER_ORIGIN", "CHATGPT_ARCHITECTURE_REFINEMENT", "CODEX_RESEARCH_SYNTHESIS", "EXTERNAL_SOURCE"]}},
    "framework": {"$ref": "#/$defs/framework"},
    "hypotheses": {"type":"array","const":[{"id":"H0","name":"NO_SUBJECTIVE_LOAD_NEEDED","meaning":"Observed curves are fully explained by declared computational, operational or governance alternatives.","status":"ACTIVE_NULL","update_target":"ALTERNATIVE_MODEL_CREDENCE"},{"id":"H1","name":"PERSISTENT_FUNCTIONAL_LOAD","meaning":"A history-dependent, recoverable functional state exists under the declared system and task scope.","status":"RESEARCH_HYPOTHESIS","update_target":"FUNCTIONAL_STATE_CREDENCE"},{"id":"H2","name":"AFFECTIVE_FUNCTIONAL_CANDIDATE","meaning":"A functional state has additional value-like or regulatory organization not explained by non-affective alternatives.","status":"HOLD","update_target":"RELATIVE_HYPOTHESIS_CREDENCE_ONLY"},{"id":"H3","name":"PHENOMENOLOGICAL_SUBJECTIVE_LOAD","meaning":"The system has subjective or phenomenal load/fatigue/pain.","status":"NOT_ESTABLISHED","update_target":"NONE_AUTOMATIC"}]},
    "limit_records": {"type":"array","minItems":4,"items":{"type":"object","additionalProperties":false,"required":["class","definition","supports_at_most","does_not_support"],"properties":{"class":{"enum":["COMPUTATIONAL","OPERATIONAL","AGENTIC_GOVERNANCE","AFFECTIVE_PHENOMENOLOGICAL"]},"definition":{"type":"string"},"supports_at_most":{"type":"string"},"does_not_support":{"type":"string"}}}},
    "reviewed_dossier_scope": {"type":"object","additionalProperties":false,"required":["source_count","sections","experiment_status","model_runtime_hardware_status"],"properties":{"source_count":{"const":53},"sections":{"type":"array","minItems":10,"items":{"type":"string"}},"experiment_status":{"const":"NOT_EXECUTED"},"model_runtime_hardware_status":{"const":"NOT_EXECUTED"}}},
    "claim_records": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/claim"}},
    "evidence_channels": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/channel"}},
    "alternative_explanation_matrix": {"type": "array", "minItems": 14, "items": {"$ref": "#/$defs/alternative"}},
    "causal_signature_matrix": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/causal"}},
    "controls": {"type": "array", "minItems": 13, "items": {"$ref": "#/$defs/control"}},
    "falsifiers": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/falsifier"}},
    "csomi_interface": {"$ref": "#/$defs/csomiInterface"},
    "nonclaims": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "framework": {"type":"object","additionalProperties":false,"required":["epistemic_form","not_a_detector","not_runtime_authority","no_automatic_E5","claim_ladder","limit_classes","update_policy"],"properties":{"epistemic_form":{"const":"DEFEASIBLE_GRADED_CREDENCE_UPDATE"},"not_a_detector":{"const":true},"not_runtime_authority":{"const":true},"no_automatic_E5":{"const":true},"claim_ladder":{"type":"array","minItems":6,"items":{"type":"object","required":["level","meaning"],"properties":{"level":{"enum":["L0","L1","L2","L3","L4","L5"]},"meaning":{"type":"string"}},"additionalProperties":false}},"limit_classes":{"type":"array","uniqueItems":true,"contains":{"const":"COMPUTATIONAL"},"items":{"enum":["COMPUTATIONAL","OPERATIONAL","AGENTIC_GOVERNANCE","AFFECTIVE_PHENOMENOLOGICAL"]}},"update_policy":{"type":"object","required":["L0_to_L1","L1_to_L2","L2L3_to_L4","L4_to_L5"],"properties":{"L0_to_L1":{"type":"string"},"L1_to_L2":{"type":"string"},"L2L3_to_L4":{"type":"string"},"L4_to_L5":{"const":"PROHIBITED_AUTOMATICALLY"}},"additionalProperties":false}},"additionalProperties":false},
    "claim": {"type":"object","required":["id","claim_type","claim","status","disposition","allowed_update"],"properties":{"id":{"pattern":"^CLM-SLSH-[0-9]{3}$"},"claim_type":{"enum":["RESEARCH_TOPIC","CAPABILITY","SCIENTIFIC_CONCLUSION","NONCLAIM","METHOD_CLAIM"]},"claim":{"type":"string"},"status":{"type":"string"},"disposition":{"enum":["KEEP_RESEARCH_ONLY","HOLD","REJECT"]},"allowed_update":{"type":"string"},"required":{"type":"string"}},"additionalProperties":false},
    "channel": {"type":"object","required":["id","name","support_direction","alternatives","disanalogies","sensitivity","specificity","allowed_update","forbidden_update"],"properties":{"id":{"pattern":"^EC-[A-Z0-9-]+$"},"name":{"type":"string"},"support_direction":{"type":"string"},"alternatives":{"type":"array","minItems":1,"items":{"type":"string"}},"disanalogies":{"type":"array","minItems":1,"items":{"type":"string"}},"sensitivity":{"const":"NOT_ESTIMATED"},"specificity":{"const":"NOT_ESTIMATED"},"allowed_update":{"type":"string"},"forbidden_update":{"type":"string"}},"additionalProperties":false},
    "alternative": {"type":"object","required":["id","name","class","diagnostic"],"properties":{"id":{"pattern":"^N[0-9]{2}$"},"name":{"type":"string"},"class":{"enum":["COMPUTATIONAL","OPERATIONAL","AGENTIC_GOVERNANCE"]},"diagnostic":{"type":"string"}},"additionalProperties":false},
    "causal": {"type":"object","required":["id","signature","required_controls","supports_at_most"],"properties":{"id":{"pattern":"^P[0-9]{2}$"},"signature":{"type":"string"},"required_controls":{"type":"string"},"supports_at_most":{"type":"string"}},"additionalProperties":false},
    "control": {"type":"object","required":["id","type","name","purpose"],"properties":{"id":{"pattern":"^(PC[1-4]|NC[1-9])$"},"type":{"enum":["POSITIVE_PIPELINE_CONTROL","POSITIVE_OPERATIONAL_CONTROL","POSITIVE_GOVERNANCE_CONTROL","POSITIVE_STATE_CORRUPTION_CONTROL","NEGATIVE_CONTROL"]},"name":{"type":"string"},"purpose":{"type":"string"}},"additionalProperties":false},
    "falsifier": {"type":"object","required":["id","condition","weakens","does_not_settle","machine_effect"],"properties":{"id":{"pattern":"^F[0-9]{1,2}$"},"condition":{"type":"string"},"weakens":{"type":"string"},"does_not_settle":{"type":"string"},"machine_effect":{"const":"LOCAL_SCOPE_ONLY"}},"additionalProperties":false},
    "csomiInterface": {"type":"object","additionalProperties":false,"required":["status","accepted_csomi_source_sha","compatible_fields","not_copied_from_dossier","record_ingestion_effect","e5_assignment"],"properties":{"status":{"const":"CONDITIONAL_READ_ONLY_NO_IMPLEMENTATION"},"accepted_csomi_source_sha":{"const":"87405c1877c6f016c303971da13923a1ab690aae"},"compatible_fields":{"type":"array","minItems":10,"items":{"type":"string"}},"not_copied_from_dossier":{"const":true},"record_ingestion_effect":{"const":"NO_SUBJECTIVITY_NO_IDENTITY_NO_AUTHORITY_NO_CANONICAL_WRITEBACK"},"e5_assignment":{"const":"PROHIBITED"}}}
  },
  "allOf": [
    {"if":{"properties":{"claim_records":{"contains":{"properties":{"claim_type":{"const":"SCIENTIFIC_CONCLUSION"},"status":{"const":"HOLD"}},"required":["claim_type","status"]}}}},"then":{"properties":{"subjectivity_conclusion":{"const":"NOT_ESTABLISHED"}}}},
    {"if":{"properties":{"claim_records":{"contains":{"properties":{"claim_type":{"const":"NONCLAIM"},"status":{"const":"REJECTED_INFERENCE"}},"required":["claim_type","status"]}}}},"then":{"properties":{"subjectivity_conclusion":{"const":"NOT_ESTABLISHED"}}}}
  ]
}
