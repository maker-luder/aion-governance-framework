{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maker-luder/aion-governance-framework/schemas/supply_chain_artifact_definition_v0.1.0.schema.json",
  "title": "AION supply-chain artifact definition v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "source_head",
    "artifact_name",
    "artifact_type",
    "artifact_sha256",
    "artifact_path",
    "output_count",
    "digest_algorithm",
    "official_release_artifact",
    "canonical_effect",
    "deployment"
  ],
  "properties": {
    "repository": {"const": "maker-luder/aion-governance-framework"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_name": {"type": "string", "pattern": "^aion-source-snapshot-[0-9a-f]{40}\\.tar$"},
    "artifact_type": {"const": "source-archive"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_path": {"type": "string", "minLength": 1},
    "output_count": {"const": 1},
    "digest_algorithm": {"const": "sha256"},
    "official_release_artifact": {"const": false},
    "canonical_effect": {"const": "NONE"},
    "deployment": {"const": false}
  }
}
