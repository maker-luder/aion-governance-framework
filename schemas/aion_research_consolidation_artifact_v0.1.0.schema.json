{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aion:schemas:research-consolidation-artifact:v0.1.0",
  "title": "AION Research Consolidation Artifact v0.1.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "canonical_effect"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "canonical_effect": {"const": "NONE"},
    "deployment": {"const": false},
    "status_vocabulary": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "CURRENT"}},
        {"contains": {"const": "HOLD"}}
      ]
    },
    "disposition_vocabulary": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "PROMOTE"}},
        {"contains": {"const": "KEEP_RESEARCH_ONLY"}},
        {"contains": {"const": "HOLD"}}
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["CURRENT", "SUPERSEDED", "HISTORICAL", "HOLD", "REJECT"]},
          "disposition": {"enum": ["PROMOTE", "KEEP_RESEARCH_ONLY", "HOLD"]}
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["CURRENT", "SUPERSEDED", "HISTORICAL", "HOLD", "REJECT"]},
          "disposition": {"enum": ["PROMOTE", "KEEP_RESEARCH_ONLY", "HOLD"]}
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "earlier", "later", "earlier_status", "later_status", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "earlier_status": {"enum": ["CURRENT", "SUPERSEDED", "HISTORICAL", "HOLD", "REJECT"]},
          "later_status": {"enum": ["CURRENT", "SUPERSEDED", "HISTORICAL", "HOLD", "REJECT"]},
          "disposition": {"enum": ["PROMOTE", "KEEP_RESEARCH_ONLY", "HOLD"]}
        }
      }
    },
    "nodes": {"type": "array", "minItems": 1},
    "edges": {"type": "array", "minItems": 1},
    "papers_and_standards": {"type": "array", "minItems": 1},
    "external_projects": {"type": "array", "minItems": 1},
    "claim_labels": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "VERIFIED"}},
        {"contains": {"const": "CORRECTION_REQUIRED"}}
      ]
    }
  },
  "allOf": [
    {"if": {"required": ["index_id"]}, "then": {"required": ["entries", "status_vocabulary", "disposition_vocabulary"]}},
    {"if": {"required": ["graph_id"]}, "then": {"required": ["nodes", "edges"]}},
    {"if": {"required": ["map_id"]}, "then": {"anyOf": [{"required": ["entries"]}, {"required": ["relations"]}]}},
    {"if": {"required": ["crosswalk_id"]}, "then": {"required": ["papers_and_standards", "external_projects", "claim_labels"]}},
    {"if": {"required": ["matrix_id"]}, "then": {"required": ["rows"]}}
  ]
}
