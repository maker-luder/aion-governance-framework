{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aion:schemas:public-discoverability-taxonomy:v0.1.0",
  "title": "AION Public Discoverability Taxonomy v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "repository", "repository_public_at_inspection", "existing_topics_at_inspection", "topics_applied", "repository_settings_modified", "canonical_effect", "deployment", "candidate_topics", "recommended_initial_set", "owner_review_set", "rejected_topics", "application_boundary"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "taxonomy_id": {"const": "AION_PUBLIC_DISCOVERABILITY_TAXONOMY_V0.1.0"},
    "repository": {"const": "maker-luder/aion-governance-framework"},
    "repository_public_at_inspection": {"const": true},
    "existing_topics_at_inspection": {"type": "array", "items": {"type": "string"}},
    "topics_applied": {"const": false},
    "repository_settings_modified": {"const": false},
    "canonical_effect": {"const": "NONE"},
    "deployment": {"const": false},
    "candidate_topics": {
      "type": "array",
      "minItems": 10,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "slug", "class", "source_basis", "readiness", "owner_review", "safe_reason"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 16},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "class": {"type": "string", "minLength": 1},
          "source_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "readiness": {"enum": ["READY_CANDIDATE", "OWNER_REVIEW_REQUIRED"]},
          "owner_review": {"enum": ["REQUIRED_BEFORE_SETTINGS_CHANGE", "REQUIRED"]},
          "safe_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommended_initial_set": {"type": "array", "minItems": 10, "maxItems": 16, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "owner_review_set": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "rejected_topics": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "reason"],
        "properties": {
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "application_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settings_operation", "owner_decision_required", "canonical_effect", "deployment"],
      "properties": {
        "settings_operation": {"const": "NOT_PERFORMED"},
        "owner_decision_required": {"const": true},
        "canonical_effect": {"const": "NONE"},
        "deployment": {"const": false}
      }
    }
  }
}
