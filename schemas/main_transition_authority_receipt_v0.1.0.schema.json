{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maker-luder/aion-governance-framework/schemas/main_transition_authority_receipt_v0.1.0.schema.json",
  "title": "Main transition authority receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "approval_id",
    "repository",
    "action",
    "target_branch",
    "target_pr",
    "target_head",
    "approval_time",
    "human_owner_explicit_approval",
    "explicit_statement",
    "approval_source",
    "account_authentication_evidence",
    "human_owner_intent_source",
    "human_identity_independently_verified",
    "human_presence_independently_verified",
    "human_intent_independently_verified",
    "human_presence_attestation",
    "fresh_for_current_action",
    "action_specific",
    "target_specific",
    "prior_authorization_inherited",
    "candidate_scope_approval_used_as_merge_authority",
    "autonomous_research_permission_used_as_merge_authority",
    "qa_pass_used_as_merge_authority",
    "ai_review_used_as_human_owner_merge_approval",
    "contradictions",
    "decision",
    "fail_closed_to",
    "canonical_effect",
    "deployment"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "MAIN_TRANSITION_AUTHORITY_RECEIPT"},
    "approval_id": {"type": "string", "format": "uuid"},
    "repository": {"type": "string", "minLength": 3},
    "action": {"const": "MERGE_PR_INTO_MAIN"},
    "target_branch": {"const": "main"},
    "target_pr": {"type": "integer", "minimum": 1},
    "target_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval_time": {"type": "string", "format": "date-time"},
    "human_owner_explicit_approval": {"const": "GIVEN"},
    "explicit_statement": {
      "const": "I explicitly approve merging the specified target PR at the specified exact head into main for this action."
    },
    "approval_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "recorded_by"],
      "properties": {
        "kind": {"const": "GITHUB_PR_BODY_EDIT"},
        "ref": {"type": "string", "format": "uri"},
        "recorded_by": {"const": "HUMAN_OWNER"}
      }
    },
    "account_authentication_evidence": {"const": "GITHUB_EVENT_SENDER_MATCH_ONLY"},
    "human_owner_intent_source": {"const": "EXTERNAL_ATTESTATION"},
    "human_identity_independently_verified": {"const": false},
    "human_presence_independently_verified": {"const": false},
    "human_intent_independently_verified": {"const": false},
    "human_presence_attestation": {"const": "EXTERNAL_TO_VALIDATOR"},
    "fresh_for_current_action": {"const": true},
    "action_specific": {"const": true},
    "target_specific": {"const": true},
    "prior_authorization_inherited": {"const": false},
    "candidate_scope_approval_used_as_merge_authority": {"const": false},
    "autonomous_research_permission_used_as_merge_authority": {"const": false},
    "qa_pass_used_as_merge_authority": {"const": false},
    "ai_review_used_as_human_owner_merge_approval": {"const": false},
    "contradictions": {"type": "array", "maxItems": 0},
    "decision": {"const": "APPROVED"},
    "fail_closed_to": {"const": "HOLD"},
    "canonical_effect": {"const": "NONE"},
    "deployment": {"const": false}
  }
}
