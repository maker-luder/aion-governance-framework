{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aion:schemas:change-level-provenance:v0.1.0",
  "title": "AION Change-Level Provenance v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance_id", "scope", "branch", "base_head", "canonical_effect", "deployment", "roles", "historical_source_preservation", "current_change_surfaces", "locks"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "provenance_id": {"const": "AION_CHANGE_LEVEL_PROVENANCE_V0.1.0"},
    "scope": {"const": "CURRENT_CONVERGENCE_FINAL_REVIEW_FIXES_ONLY"},
    "branch": {"const": "engineering/aion-research-consolidation-literature-grounding-readiness-20260814"},
    "base_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "canonical_effect": {"const": "NONE"},
    "deployment": {"const": false},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_owner_proposal_and_authority", "chatgpt_architecture_and_review", "manus_implementation", "owner_approval"],
      "properties": {
        "human_owner_proposal_and_authority": {"$ref": "#/$defs/humanOwnerTaskAuthority"},
        "chatgpt_architecture_and_review": {"$ref": "#/$defs/chatGPTFinalReview"},
        "manus_implementation": {"$ref": "#/$defs/manusImplementation"},
        "owner_approval": {"$ref": "#/$defs/ownerApproval"}
      }
    },
    "historical_source_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical_p2_provenance_edited", "historical_p2_authorship_rewritten", "original_p2_source_refs_retained", "historical_source_ref", "current_convergence_provenance_is_distinct"],
      "properties": {
        "historical_p2_provenance_edited": {"const": false},
        "historical_p2_authorship_rewritten": {"const": false},
        "original_p2_source_refs_retained": {"const": true},
        "historical_source_ref": {"const": "research-labs/four-domain-p2-materialization_v0.1.0"},
        "current_convergence_provenance_is_distinct": {"const": true}
      }
    },
    "current_change_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "locks": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "humanOwnerTaskAuthority": {
      "allOf": [
        {"$ref": "#/$defs/role"},
        {"properties": {"actor": {"const": "HUMAN_OWNER"}, "role": {"const": "TASK_AUTHORIZATION_AND_FINAL_AUTHORITY"}, "status": {"const": "TASK_AUTHORIZED_OWNER_APPROVAL_PENDING"}}}
      ]
    },
    "chatGPTFinalReview": {
      "allOf": [
        {"$ref": "#/$defs/role"},
        {"properties": {"actor": {"const": "CHATGPT"}, "role": {"const": "FINAL_REVIEW_FINDINGS_AND_ARCHITECTURE_REVIEW"}, "status": {"const": "FINAL_REVIEW_FINDINGS_PROPOSED"}}}
      ]
    },
    "manusImplementation": {
      "allOf": [
        {"$ref": "#/$defs/role"},
        {"properties": {"actor": {"const": "MANUS"}, "role": {"const": "CONVERGENCE_IMPLEMENTATION_AND_VALIDATION"}, "status": {"const": "IMPLEMENTED_ON_CONVERGENCE_BRANCH"}}}
      ]
    },
    "ownerApproval": {
      "allOf": [
        {"$ref": "#/$defs/role"},
        {"properties": {"actor": {"const": "HUMAN_OWNER"}, "role": {"const": "APPROVAL_GATE"}, "status": {"const": "PENDING"}}}
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "role", "status", "authority_effect", "description"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "authority_effect": {"const": "NONE"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
