{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-governance-framework.local/schemas/aion_slsh_source_provenance_v0.1.0.schema.json",
  "title": "AION SLSH Source Provenance Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_id","input_type","input_file","input_sha256","source_branch","source_sha","branch","source_rows","grade_policy","no_automatic_upgrade","no_subjectivity_conclusion"],
  "properties": {
    "schema_version":{"const":"0.1.0"},
    "record_id":{"const":"AION_SLSH_SOURCE_PROVENANCE_LOG_V0.1.0"},
    "input_type":{"const":"CODEX_EXTERNAL_RESEARCH_INPUT"},
    "input_file":{"const":"AION_SUBJECTIVE_LOAD_SENSITIVITY_RESEARCH_REVIEW_v0.1.txt"},
    "input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_branch":{"const":"research/cross-substrate-other-minds-inference-20260814"},
    "source_sha":{"const":"87405c1877c6f016c303971da13923a1ab690aae"},
    "branch":{"const":"research/subjective-load-sensitivity-hypothesis-20260814"},
    "source_rows":{"type":"array","minItems":53,"maxItems":53,"items":{"$ref":"#/$defs/source"}},
    "grade_policy":{"type":"object","required":["PRIMARY_FULLTEXT_DIRECTLY_VERIFIED","PRIMARY_ABSTRACT_DIRECTLY_VERIFIED","PRIMARY_METADATA_VERIFIED","CODEX_EXTERNAL_RESEARCH_INPUT"],"additionalProperties":false,"properties":{"PRIMARY_FULLTEXT_DIRECTLY_VERIFIED":{"type":"string"},"PRIMARY_ABSTRACT_DIRECTLY_VERIFIED":{"type":"string"},"PRIMARY_METADATA_VERIFIED":{"type":"string"},"CODEX_EXTERNAL_RESEARCH_INPUT":{"type":"string"}}},
    "no_automatic_upgrade":{"const":true},
    "no_subjectivity_conclusion":{"const":true}
  },
  "$defs": {
    "source": {
      "type":"object","additionalProperties":false,
      "required":["id","title_as_recorded","identifier_as_recorded","access_evidence","verification_status","access_evidence_provenance","supports_as_recorded","does_not_support_as_recorded","external_source_claim_boundary"],
      "properties":{
        "id":{"pattern":"^S[0-9]{2}$"},
        "title_as_recorded":{"type":"string","minLength":1},
        "identifier_as_recorded":{"type":"string","minLength":1},
        "access_evidence":{"type":"string","minLength":1},
        "verification_status":{"enum":["PRIMARY_FULLTEXT_DIRECTLY_VERIFIED","PRIMARY_ABSTRACT_DIRECTLY_VERIFIED","PRIMARY_METADATA_VERIFIED"]},
        "access_evidence_provenance":{"const":"CODEX_EXTERNAL_RESEARCH_INPUT_AS_RECORDED"},
        "supports_as_recorded":{"type":"string"},
        "does_not_support_as_recorded":{"type":"string"},
        "external_source_claim_boundary":{"const":"Only the source's recorded support is admissible; no direct AION, AI, SLSH or subjectivity conclusion is inferred."}
      },
      "allOf":[
        {"if":{"properties":{"verification_status":{"const":"PRIMARY_FULLTEXT_DIRECTLY_VERIFIED"}}},"then":{"properties":{"access_evidence":{"pattern":"(?i)(full text|full article|open pdf|open standard|official documentation|open access|open archive/full page|free access|free to read|open web declaration|open report|full access page)"}}}},
        {"if":{"properties":{"verification_status":{"const":"PRIMARY_ABSTRACT_DIRECTLY_VERIFIED"}}},"then":{"properties":{"access_evidence":{"pattern":"(?i)abstract"}}}},
        {"if":{"properties":{"verification_status":{"const":"PRIMARY_METADATA_VERIFIED"}}},"then":{"properties":{"access_evidence":{"pattern":"(?i)(metadata|bibliographic|doi|index|record|book|目錄/書目)"}}}}
      ]
    }
  }
}
