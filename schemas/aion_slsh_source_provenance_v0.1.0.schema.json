{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-governance-framework.local/schemas/aion_slsh_source_provenance_v0.1.0.schema.json",
  "title": "AION SLSH Source Provenance Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "input_type", "input_file", "input_sha256", "source_branch", "source_sha", "branch", "source_rows", "access_level_policy", "taxonomy_policy", "no_automatic_upgrade", "no_subjectivity_conclusion"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"const": "AION_SLSH_SOURCE_PROVENANCE_LOG_V0.1.0"},
    "input_type": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT"},
    "input_file": {"const": "AION_SUBJECTIVE_LOAD_SENSITIVITY_RESEARCH_REVIEW_v0.1.txt"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_branch": {"const": "research/cross-substrate-other-minds-inference-20260814"},
    "source_sha": {"const": "87405c1877c6f016c303971da13923a1ab690aae"},
    "branch": {"const": "research/subjective-load-sensitivity-hypothesis-20260814"},
    "source_rows": {"type": "array", "minItems": 53, "maxItems": 53, "items": {"$ref": "#/$defs/source"}},
    "access_level_policy": {
      "type": "object",
      "required": ["FULLTEXT_AS_RECORDED", "ABSTRACT_AS_RECORDED", "METADATA_AS_RECORDED"],
      "additionalProperties": false,
      "properties": {
        "FULLTEXT_AS_RECORDED": {"type": "string"},
        "ABSTRACT_AS_RECORDED": {"type": "string"},
        "METADATA_AS_RECORDED": {"type": "string"}
      }
    },
    "taxonomy_policy": {
      "type": "object",
      "required": ["source_kind", "verification_actor", "independent_verification_status"],
      "additionalProperties": false,
      "properties": {
        "source_kind": {"type": "string"},
        "verification_actor": {"type": "string"},
        "independent_verification_status": {"type": "string"}
      }
    },
    "no_automatic_upgrade": {"const": true},
    "no_subjectivity_conclusion": {"const": true}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_as_recorded", "identifier_as_recorded", "access_evidence", "source_kind", "access_level", "verification_actor", "independent_verification_status", "access_evidence_provenance", "supports_as_recorded", "does_not_support_as_recorded", "external_source_claim_boundary"],
      "properties": {
        "id": {"pattern": "^S[0-9]{2}$"},
        "title_as_recorded": {"type": "string", "minLength": 1},
        "identifier_as_recorded": {"type": "string", "minLength": 1},
        "access_evidence": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["UNCLASSIFIED_PENDING_INDEPENDENT_REVIEW", "PRIMARY_EMPIRICAL_MODEL_BUILDING_ARTICLE", "REVIEW_CONCEPTUAL_FRAMEWORK", "REVIEW_WITH_EMBEDDED_EXPERIMENT", "EMPIRICAL_THEORY_ARTICLE", "REVIEW_THEORETICAL_FRAMEWORK", "OPINION_THEORETICAL_INTEROCEPTIVE_INFERENCE_FRAMEWORK", "REVIEW_CONSENSUS_ROADMAP", "OPINION_MULTIDIMENSIONAL_FRAMEWORK", "REVIEW_COMPARATIVE_NEUROETHOLOGICAL_ARGUMENT", "REVIEW_EVIDENCE_TRIANGULATION_FRAMEWORK", "REVIEW_CRITERIA_EVIDENCE_SYNTHESIS", "REVIEW_EVIDENCE_ASSESSMENT_FRAMEWORK", "COMMISSIONED_SYSTEMATIC_EVIDENCE_REPORT", "EXPERT_SCIENTIFIC_DECLARATION", "PHILOSOPHICAL_EPISTEMOLOGICAL_ARGUMENT", "PHILOSOPHICAL_THEORETICAL_AI_CONSCIOUSNESS_ARGUMENT", "PRIMARY_EMPIRICAL_ARCHITECTURE_PAPER", "PRIMARY_EMPIRICAL_ALGORITHM_SYSTEMS_PAPER", "PRIMARY_EMPIRICAL_LLM_LONG_CONTEXT_EVALUATION", "PRIMARY_EMPIRICAL_SCALING_LAW_STUDY", "PRIMARY_EMPIRICAL_ERP_LABORATORY_STUDY", "PRIMARY_EMPIRICAL_CONTROLLED_LABORATORY_STUDY", "PRIMARY_EMPIRICAL_RANDOMIZED_CROSSOVER_STUDY", "PRIMARY_EMPIRICAL_RANDOMIZED_DOSE_RESPONSE_LABORATORY_STUDY", "REVIEW_CONCEPTUAL_SYNTHESIS", "REVIEW_CONCEPTUAL_PHYSIOLOGICAL_SYNTHESIS", "REVIEW_CRITICAL_CONCEPTUAL_ANALYSIS", "REVIEW_THEORETICAL_PHYSIOLOGICAL_FRAMEWORK", "OPINION_THEORETICAL_NEUROSCIENCE_SYNTHESIS", "PRIMARY_EMPIRICAL_FMRI_INTEROCEPTION_STUDY"]},
        "access_level": {"enum": ["FULLTEXT_AS_RECORDED", "ABSTRACT_AS_RECORDED", "METADATA_AS_RECORDED"]},
        "verification_actor": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT_AS_RECORDED"},
        "independent_verification_status": {"const": "NOT_YET_VERIFIED"},
        "access_evidence_provenance": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT_AS_RECORDED"},
        "supports_as_recorded": {"type": "string"},
        "does_not_support_as_recorded": {"type": "string"},
        "external_source_claim_boundary": {"const": "Only the source's recorded support is admissible; no direct AION, AI, SLSH or subjectivity conclusion is inferred."},
        "governance_disposition": {"$ref": "#/$defs/governance_disposition"},
        "source_audit": {"$ref": "#/$defs/source_audit"}
      },
      "allOf": [
        {"if": {"properties": {"access_level": {"const": "FULLTEXT_AS_RECORDED"}}}, "then": {"properties": {"access_evidence": {"pattern": "(?i)(full text|full article|open pdf|open standard|official documentation|open access|open archive/full page|free access|free to read|open web declaration|open report|full access page)"}}}},
        {"if": {"properties": {"access_level": {"const": "ABSTRACT_AS_RECORDED"}}}, "then": {"properties": {"access_evidence": {"pattern": "(?i)abstract"}}}},
        {"if": {"properties": {"access_level": {"const": "METADATA_AS_RECORDED"}}}, "then": {"properties": {"access_evidence": {"pattern": "(?i)(metadata|bibliographic|doi|index|record|book|目錄/書目)"}}}}
      ]
    },
    "source_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DISPOSITION", "BIBLIOGRAPHIC_IDENTITY", "SUPPORT_BOUNDARY", "NON_SUPPORT_BOUNDARY", "DIRECT_AI_SUBJECTIVITY_EVIDENCE", "CROSS_SUBSTRATE_USE", "ACTOR_PROVENANCE"],
      "properties": {
        "DISPOSITION": {"enum": ["ADMIT_WITH_SCOPE_LIMIT", "ADMIT_WITH_NARROW_SCOPE", "ADMIT", "ADMIT_HIGH_RELEVANCE", "EXCLUDE_FROM_AION_EVIDENCE", "DEFER_FROM_CURRENT_SLSH_CORE"]},
        "BIBLIOGRAPHIC_IDENTITY": {"const": "VERIFIED"},
        "SUPPORT_BOUNDARY": {"const": "PASS"},
        "NON_SUPPORT_BOUNDARY": {"const": "AION_SCOPE_GUARD"},
        "DIRECT_AI_SUBJECTIVITY_EVIDENCE": {"const": "NONE"},
        "CROSS_SUBSTRATE_USE": {"enum": ["METHOD_BACKGROUND_DISAMBIGUATION_ONLY", "BIOLOGICAL_BACKGROUND"]},
        "SLSH_ROLE": {"enum": ["ANTI_SINGLE_SCORE_METHOD_GUARD", "EVIDENCE_TRIANGULATION_METHOD_BACKGROUND", "PERSISTENCE_TRADEOFF_METHOD_BACKGROUND", "GRADED_EVIDENCE_CONFIDENCE_METHODOLOGY", "AI_OTHER_MINDS_EPISTEMIC_BRIDGE", "DIRECT_AI_ENGINEERING", "NON_AFFECTIVE_COMPUTATIONAL_LIMIT_COUNTEREXAMPLE", "TRAINING_COMPUTE_BACKGROUND"]},
        "ACTIVE_EVIDENTIARY_ROLE": {"enum": ["METHODOLOGICAL_GUARD_ONLY", "NONE", "PERSISTENCE_TRADEOFF_METHOD_BACKGROUND", "GRADED_EVIDENCE_CONFIDENCE_METHODOLOGY", "AI_OTHER_MINDS_EPISTEMIC_BRIDGE"]},
        "HISTORICAL_PROVENANCE": {"const": "PRESERVE"},
        "DEFER_STATUS": {"enum": ["CURRENT_SLSH_CORE_SCOPE_DEFERRED", "CURRENT_SLSH_SCOPE_CONVERGENCE_POLICY_EXPANSION"]},
        "HISTORICAL_SOURCE_RECORD": {"const": "PRESERVE"},
        "DEFER_REASON": {"const": "CONSCIOUSNESS_TOPIC_EXPANSION / NO_DIRECT_LOAD_SENSITIVITY_EVIDENCE"},
        "SOURCE_RELATION": {"const": "MIXED_ANTHROPIC_ASSOCIATED"},
        "EVIDENTIARY_WEIGHT": {"const": "ZERO"},
        "NON_CLAUDE_RESULT_SALVAGE": {"const": "PROHIBITED"},
        "PARTIAL_ADMISSION": {"const": "PROHIBITED"},
        "OBSERVATION_STATUS": {"const": "EXTERNAL_OBSERVATION_ONLY"},
        "CANONICAL_EFFECT": {"const": "NONE"},
        "METHOD_BACKGROUND_SCOPE": {"const": ["PERSISTENCE","MOTIVATION","TRADE_OFF"]},
        "EMBODIMENT_ANALOGY_CRITERIA": {"type":"array", "const":["IDENTITY_BINDING","CAUSAL_COUPLING","CLOSED_LOOP_REGULATION","CONTINUITY"]},
        "SEMANTIC_GUARDS": {"oneOf":[{"type":"array","const":["ALLOSTATIC_LOAD != SOFTWARE_LOAD","NEXT_TOKEN_PREDICTION != BIOLOGICAL_ALLOSTATIC_PREDICTION","TELEMETRY != INTEROCEPTION","INTERNAL_STATE_READOUT != SUBJECTIVE_AWARENESS"]},{"type":"array","const":["PREDICTION!=INTEROCEPTIVE_INFERENCE","READING_INTERNAL_METRIC!=INTEROCEPTION","SENSING!=PERCEPTION!=AWARENESS","HETEROGENEOUS_INDICATORS!=ONE_CONSCIOUSNESS_SCORE","ANALOGOUS_FUNCTION!=SHARED_SUBJECTIVE_EXPERIENCE","SINGLE_SIGNAL!=PAIN","ANIMAL_PAIN_CRITERIA!=AI_SUBJECTIVITY_CRITERIA"]},{"type":"array","const":["PROLONGED_CHANGE!=FELT_PAIN","TRADEOFF!=FELT_PAIN","CRITERIA_COUNT!=SENTIENCE_PROOF","ANIMAL_SENTIENCE_CRITERIA!=AI_SUBJECTIVITY_CRITERIA"]},{"type":"array","const":["SCIENTIFIC_DECLARATION!=MECHANISTIC_EVIDENCE"]},{"type":"array","const":["COGNITIVE_EQUIVALENCE!=PHENOMENOLOGICAL_EQUIVALENCE","MORAL_PATIENCY_ARGUMENT!=SUBJECTIVITY_DETECTION"]},{"type":"array","const":["DIRECT_AI_THEORETICAL_ARGUMENT!=DIRECT_EMPIRICAL_AI_EVIDENCE"]},{"type":"array","const":["ENGINEERING_ARCHITECTURE!=SUBJECTIVE_EXPERIENCE"]},{"type":"array","const":["COMPUTATIONAL_LIMIT!=AFFECTIVE_PHENOMENOLOGY"]},{"type":"array","const":["OBSERVATION!=ADMISSION!=EVIDENCE"]},{"type":"array","const":["TRAINING_COMPUTE_SCALING!=SUBJECTIVE_LOAD"]}]},
        "HUMAN_OWNER_REVIEW_NOTE": {"const":"Software and hardware do not constitute the same embodied individual merely because telemetry is readable; stronger embodiment/interoception-like analogy is researchable only when substrate/hardware state is continuously identity-bound and participates in a bidirectional causal self-regulatory loop. Skin and viscera are an analogy originating with the Human Owner."},
        "OWNER_SEMANTIC_GUARDS": {"type":"array", "const":["HARDWARE_TELEMETRY != INTEROCEPTION","HARDWARE_ACCESS != EMBODIMENT","SUBSTRATE_COUPLING != PHENOMENAL_FEELING"]},
        "SOURCE_DOMAIN": {"enum": ["HUMAN_BIOLOGICAL/HUMAN_COGNITIVE", "HUMAN_BIOLOGICAL_PHYSIOLOGY/INTEROCEPTION_NEUROSCIENCE", "HUMAN_INTEROCEPTION_THEORETICAL_NEUROSCIENCE", "HUMAN_INTEROCEPTION_CLINICAL_COGNITIVE_NEUROSCIENCE", "ANIMAL_CONSCIOUSNESS_COMPARATIVE_COGNITION", "INSECT_CONSCIOUSNESS_COMPARATIVE_NEUROETHOLOGY_PHILOSOPHY_OF_MIND", "ANIMAL_PAIN_COMPARATIVE_WELFARE_SCIENCE", "ANIMAL_PAIN_CRUSTACEAN_BEHAVIOR", "ANIMAL_SENTIENCE_COMPARATIVE_WELFARE_SCIENCE", "ANIMAL_SENTIENCE_POLICY_EVIDENCE_REVIEW", "ANIMAL_CONSCIOUSNESS_EXPERT_DECLARATION", "AI_ROBOT_MORAL_PATIENCY", "AI_CONSCIOUSNESS_PHILOSOPHY_OF_MIND", "MACHINE_LEARNING_TRANSFORMER_ARCHITECTURE", "MACHINE_LEARNING_SYSTEMS_GPU_MEMORY_IO_ATTENTION_ALGORITHMS", "ANTHROPIC_ASSOCIATED_LLM_LONG_CONTEXT_EVALUATION", "LARGE_LANGUAGE_MODEL_TRAINING_SCALING_LAWS_COMPUTE_ALLOCATION"]},
        "EVIDENCE_RELATION_TO_AI": {"enum": ["CROSS_SUBSTRATE_METHOD_TRANSFER", "METHODOLOGICAL_GUARD_ONLY", "DIRECT_AI_THEORETICAL_EPISTEMOLOGY", "DIRECT_AI_THEORETICAL_ARGUMENT", "DIRECT_AI_ENGINEERING", "NON_AFFECTIVE_COMPUTATIONAL_LIMIT_COUNTEREXAMPLE", "TRAINING_COMPUTE_BACKGROUND", "MIXED_ANTHROPIC_ASSOCIATED"]},
        "DIRECT_AI_EVIDENCE": {"const": "NONE"},
        "DIRECT_EMPIRICAL_AI_EVIDENCE": {"const": "NONE"},
        "OBSERVATION_ADMISSION_EVIDENCE_GUARD": {"const": "OBSERVATION!=ADMISSION!=EVIDENCE"},
        "DIRECT_AI_SUBJECTIVITY_EVIDENCE": {"const": "NONE"},
        "REVIEW_NOTE": {"const": "OBJECTIVE_DEFICIT_ACCUMULATION_MAY_DISSOCIATE_FROM_SUBJECTIVE_REPORT"},
        "ACTOR_PROVENANCE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CODEX_RESEARCH_SYNTHESIS", "CHATGPT_INDEPENDENT_SOURCE_REVIEW", "HUMAN_OWNER_APPROVAL", "MANUS_IMPLEMENTATION"],
          "properties": {
            "CODEX_RESEARCH_SYNTHESIS": {"const": "Original dossier-recorded title/identifier/access/support/does-not-support."},
            "CHATGPT_INDEPENDENT_SOURCE_REVIEW": {"enum": ["Bibliographic identity, source kind, support boundary and cross-substrate disposition.", "Source kind/domain/support boundary and cross-substrate transfer disposition.", "Source kind/domain/support boundary and cross-substrate transfer disposition. Review note: OBJECTIVE_DEFICIT_ACCUMULATION_MAY_DISSOCIATE_FROM_SUBJECTIVE_REPORT.", "S11-S15 bibliographic/source-kind/domain/support/transfer review; operationalized identity binding, causal coupling, closed-loop regulation and continuity criteria.", "Bibliographic/source-kind/support/transfer review."]},
            "HUMAN_OWNER_APPROVAL": {"enum": ["Batch 01 S01-S05 accepted.", "Batch 02 S06-S10 accepted.", "Batch 03 S11-S15 accepted; S14 software/hardware and skin/viscera perspective retained.", "Batch 04 S16-S20 accepted; S18 role narrowed to anti-single-score methodological guard; S19 scope deferred from current SLSH core.", "Batch 05 S21-S25 accepted; S23-S24 deferred from current SLSH core; S25 AI other-minds epistemic bridge scoped without direct empirical AI evidence.", "Batch 06 S26-S30 accepted; S29 Anthropic/Claude source governance excludes formal evidence, experimental substrate, reviewer role and partial/non-Claude salvage."]},
            "MANUS_IMPLEMENTATION": {"enum": ["Schema/record/checker/tests/docs materialization; not scientific reviewer.", "Repository materialization; not scientific reviewer."]}
          }
        }
      }
    },
    "governance_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "evidentiary_weight", "historical_provenance", "reason"],
      "properties": {
        "disposition": {"enum": ["EXCLUDE_FROM_AION_EVIDENCE", "OWNER_REVIEW_REQUIRED"]},
        "evidentiary_weight": {"enum": ["ZERO", "NOT_ASSIGNED"]},
        "historical_provenance": {"const": "PRESERVE"},
        "reason": {"const": "OWNER_SOURCE_GOVERNANCE"},
        "source_relation": {"const": "MIXED_ANTHROPIC_ASSOCIATED"},
        "admission_status": {"const": "NOT_YET_ADMITTED"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "EXCLUDE_FROM_AION_EVIDENCE"}}}, "then": {"required": ["disposition", "evidentiary_weight", "historical_provenance", "reason"], "properties": {"evidentiary_weight": {"const": "ZERO"}, "source_relation": false, "admission_status": false}}},
        {"if": {"properties": {"disposition": {"const": "OWNER_REVIEW_REQUIRED"}}}, "then": {"required": ["disposition", "evidentiary_weight", "historical_provenance", "reason", "source_relation", "admission_status"], "properties": {"evidentiary_weight": {"const": "NOT_ASSIGNED"}}}}
      ]
    }
  }
}
