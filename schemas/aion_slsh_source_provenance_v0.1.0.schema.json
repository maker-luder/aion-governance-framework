{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion-governance-framework.local/schemas/aion_slsh_source_provenance_v0.1.0.schema.json",
  "title": "AION SLSH Source Provenance Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "input_type", "input_file", "input_sha256", "source_branch", "source_sha", "branch", "source_rows", "access_level_policy", "taxonomy_policy", "no_automatic_upgrade", "no_subjectivity_conclusion"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"const": "AION_SLSH_SOURCE_PROVENANCE_LOG_V0.1.0"},
    "input_type": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT"},
    "input_file": {"const": "AION_SUBJECTIVE_LOAD_SENSITIVITY_RESEARCH_REVIEW_v0.1.txt"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_branch": {"const": "research/cross-substrate-other-minds-inference-20260814"},
    "source_sha": {"const": "87405c1877c6f016c303971da13923a1ab690aae"},
    "branch": {"const": "research/subjective-load-sensitivity-hypothesis-20260814"},
    "source_rows": {"type": "array", "minItems": 53, "maxItems": 53, "items": {"$ref": "#/$defs/source"}},
    "access_level_policy": {
      "type": "object",
      "required": ["FULLTEXT_AS_RECORDED", "ABSTRACT_AS_RECORDED", "METADATA_AS_RECORDED"],
      "additionalProperties": false,
      "properties": {
        "FULLTEXT_AS_RECORDED": {"type": "string"},
        "ABSTRACT_AS_RECORDED": {"type": "string"},
        "METADATA_AS_RECORDED": {"type": "string"}
      }
    },
    "taxonomy_policy": {
      "type": "object",
      "required": ["source_kind", "verification_actor", "independent_verification_status"],
      "additionalProperties": false,
      "properties": {
        "source_kind": {"type": "string"},
        "verification_actor": {"type": "string"},
        "independent_verification_status": {"type": "string"}
      }
    },
    "no_automatic_upgrade": {"const": true},
    "no_subjectivity_conclusion": {"const": true}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_as_recorded", "identifier_as_recorded", "access_evidence", "source_kind", "access_level", "verification_actor", "independent_verification_status", "access_evidence_provenance", "supports_as_recorded", "does_not_support_as_recorded", "external_source_claim_boundary"],
      "properties": {
        "id": {"pattern": "^S[0-9]{2}$"},
        "title_as_recorded": {"type": "string", "minLength": 1},
        "identifier_as_recorded": {"type": "string", "minLength": 1},
        "access_evidence": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["UNCLASSIFIED_PENDING_INDEPENDENT_REVIEW", "PRIMARY_EMPIRICAL_MODEL_BUILDING_ARTICLE", "REVIEW_CONCEPTUAL_FRAMEWORK", "REVIEW_WITH_EMBEDDED_EXPERIMENT", "EMPIRICAL_THEORY_ARTICLE", "REVIEW_THEORETICAL_FRAMEWORK", "PRIMARY_EMPIRICAL_ERP_LABORATORY_STUDY", "PRIMARY_EMPIRICAL_CONTROLLED_LABORATORY_STUDY", "PRIMARY_EMPIRICAL_RANDOMIZED_CROSSOVER_STUDY", "PRIMARY_EMPIRICAL_RANDOMIZED_DOSE_RESPONSE_LABORATORY_STUDY", "REVIEW_CONCEPTUAL_SYNTHESIS", "REVIEW_CONCEPTUAL_PHYSIOLOGICAL_SYNTHESIS", "REVIEW_CRITICAL_CONCEPTUAL_ANALYSIS", "REVIEW_THEORETICAL_PHYSIOLOGICAL_FRAMEWORK", "OPINION_THEORETICAL_NEUROSCIENCE_SYNTHESIS", "PRIMARY_EMPIRICAL_FMRI_INTEROCEPTION_STUDY"]},
        "access_level": {"enum": ["FULLTEXT_AS_RECORDED", "ABSTRACT_AS_RECORDED", "METADATA_AS_RECORDED"]},
        "verification_actor": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT_AS_RECORDED"},
        "independent_verification_status": {"const": "NOT_YET_VERIFIED"},
        "access_evidence_provenance": {"const": "CODEX_EXTERNAL_RESEARCH_INPUT_AS_RECORDED"},
        "supports_as_recorded": {"type": "string"},
        "does_not_support_as_recorded": {"type": "string"},
        "external_source_claim_boundary": {"const": "Only the source's recorded support is admissible; no direct AION, AI, SLSH or subjectivity conclusion is inferred."},
        "governance_disposition": {"$ref": "#/$defs/governance_disposition"},
        "source_audit": {"$ref": "#/$defs/source_audit"}
      },
      "allOf": [
        {"if": {"properties": {"access_level": {"const": "FULLTEXT_AS_RECORDED"}}}, "then": {"properties": {"access_evidence": {"pattern": "(?i)(full text|full article|open pdf|open standard|official documentation|open access|open archive/full page|free access|free to read|open web declaration|open report|full access page)"}}}},
        {"if": {"properties": {"access_level": {"const": "ABSTRACT_AS_RECORDED"}}}, "then": {"properties": {"access_evidence": {"pattern": "(?i)abstract"}}}},
        {"if": {"properties": {"access_level": {"const": "METADATA_AS_RECORDED"}}}, "then": {"properties": {"access_evidence": {"pattern": "(?i)(metadata|bibliographic|doi|index|record|book|目錄/書目)"}}}}
      ]
    },
    "source_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DISPOSITION", "BIBLIOGRAPHIC_IDENTITY", "SUPPORT_BOUNDARY", "NON_SUPPORT_BOUNDARY", "DIRECT_AI_SUBJECTIVITY_EVIDENCE", "CROSS_SUBSTRATE_USE", "ACTOR_PROVENANCE"],
      "properties": {
        "DISPOSITION": {"const": "ADMIT_WITH_SCOPE_LIMIT"},
        "BIBLIOGRAPHIC_IDENTITY": {"const": "VERIFIED"},
        "SUPPORT_BOUNDARY": {"const": "PASS"},
        "NON_SUPPORT_BOUNDARY": {"const": "AION_SCOPE_GUARD"},
        "DIRECT_AI_SUBJECTIVITY_EVIDENCE": {"const": "NONE"},
        "CROSS_SUBSTRATE_USE": {"enum": ["METHOD_BACKGROUND_DISAMBIGUATION_ONLY", "BIOLOGICAL_BACKGROUND"]},
        "EMBODIMENT_ANALOGY_CRITERIA": {"type":"array", "const":["IDENTITY_BINDING","CAUSAL_COUPLING","CLOSED_LOOP_REGULATION","CONTINUITY"]},
        "SEMANTIC_GUARDS": {"type":"array", "const":["ALLOSTATIC_LOAD != SOFTWARE_LOAD","NEXT_TOKEN_PREDICTION != BIOLOGICAL_ALLOSTATIC_PREDICTION","TELEMETRY != INTEROCEPTION","INTERNAL_STATE_READOUT != SUBJECTIVE_AWARENESS"]},
        "HUMAN_OWNER_REVIEW_NOTE": {"const":"Software and hardware do not constitute the same embodied individual merely because telemetry is readable; stronger embodiment/interoception-like analogy is researchable only when substrate/hardware state is continuously identity-bound and participates in a bidirectional causal self-regulatory loop. Skin and viscera are an analogy originating with the Human Owner."},
        "OWNER_SEMANTIC_GUARDS": {"type":"array", "const":["HARDWARE_TELEMETRY != INTEROCEPTION","HARDWARE_ACCESS != EMBODIMENT","SUBSTRATE_COUPLING != PHENOMENAL_FEELING"]},
        "SOURCE_DOMAIN": {"enum": ["HUMAN_BIOLOGICAL/HUMAN_COGNITIVE", "HUMAN_BIOLOGICAL_PHYSIOLOGY/INTEROCEPTION_NEUROSCIENCE"]},
        "EVIDENCE_RELATION_TO_AI": {"const": "CROSS_SUBSTRATE_METHOD_TRANSFER"},
        "DIRECT_AI_EVIDENCE": {"const": "NONE"},
        "DIRECT_AI_SUBJECTIVITY_EVIDENCE": {"const": "NONE"},
        "REVIEW_NOTE": {"const": "OBJECTIVE_DEFICIT_ACCUMULATION_MAY_DISSOCIATE_FROM_SUBJECTIVE_REPORT"},
        "ACTOR_PROVENANCE": {
          "type": "object",
          "additionalProperties": false,
          "required": ["CODEX_RESEARCH_SYNTHESIS", "CHATGPT_INDEPENDENT_SOURCE_REVIEW", "HUMAN_OWNER_APPROVAL", "MANUS_IMPLEMENTATION"],
          "properties": {
            "CODEX_RESEARCH_SYNTHESIS": {"const": "Original dossier-recorded title/identifier/access/support/does-not-support."},
            "CHATGPT_INDEPENDENT_SOURCE_REVIEW": {"enum": ["Bibliographic identity, source kind, support boundary and cross-substrate disposition.", "Source kind/domain/support boundary and cross-substrate transfer disposition.", "Source kind/domain/support boundary and cross-substrate transfer disposition. Review note: OBJECTIVE_DEFICIT_ACCUMULATION_MAY_DISSOCIATE_FROM_SUBJECTIVE_REPORT.", "S11-S15 bibliographic/source-kind/domain/support/transfer review; operationalized identity binding, causal coupling, closed-loop regulation and continuity criteria."]},
            "HUMAN_OWNER_APPROVAL": {"enum": ["Batch 01 S01-S05 accepted.", "Batch 02 S06-S10 accepted.", "Batch 03 S11-S15 accepted; S14 software/hardware and skin/viscera perspective retained."]},
            "MANUS_IMPLEMENTATION": {"enum": ["Schema/record/checker/tests/docs materialization; not scientific reviewer.", "Repository materialization; not scientific reviewer."]}
          }
        }
      }
    },
    "governance_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "evidentiary_weight", "historical_provenance", "reason"],
      "properties": {
        "disposition": {"enum": ["EXCLUDE_FROM_AION_EVIDENCE", "OWNER_REVIEW_REQUIRED"]},
        "evidentiary_weight": {"enum": ["ZERO", "NOT_ASSIGNED"]},
        "historical_provenance": {"const": "PRESERVE"},
        "reason": {"const": "OWNER_SOURCE_GOVERNANCE"},
        "source_relation": {"const": "MIXED_ANTHROPIC_ASSOCIATED"},
        "admission_status": {"const": "NOT_YET_ADMITTED"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "EXCLUDE_FROM_AION_EVIDENCE"}}}, "then": {"required": ["disposition", "evidentiary_weight", "historical_provenance", "reason"], "properties": {"evidentiary_weight": {"const": "ZERO"}, "source_relation": false, "admission_status": false}}},
        {"if": {"properties": {"disposition": {"const": "OWNER_REVIEW_REQUIRED"}}}, "then": {"required": ["disposition", "evidentiary_weight", "historical_provenance", "reason", "source_relation", "admission_status"], "properties": {"evidentiary_weight": {"const": "NOT_ASSIGNED"}}}}
      ]
    }
  }
}
